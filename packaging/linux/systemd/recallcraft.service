# systemd user unit for the RecallCraft service: the alternative to the autostart entry RecallCraft
# writes itself (~/.config/autostart/io.github.billsecond.recallcraft.desktop) for sessions managed
# by systemd. Installed but not enabled by the .deb and .rpm. To use it instead, turn "Start
# RecallCraft when I sign in" off in RecallCraft's settings, then:
#
#   systemctl --user enable --now recallcraft.service
#
# systemd supervises here, so it runs the service directly (--tray), not the supervisor that the
# autostart entry starts (--background).
[Unit]
Description=RecallCraft (the last two days of what was said, and calls written down)
Documentation=https://github.com/billsecond/recallcraft
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/recallcraft --tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
